{
  "name": "siap-tempur",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run lint && npm run typecheck",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "format": "node scripts/check-format-tools.mjs && prettier --write . && node scripts/format-sql.mjs && ruff format scripts && find scripts -type f -name '*.sh' -print0 | xargs -0 shfmt -w -i 2 -ci -bn",
    "format:check": "node scripts/check-format-tools.mjs && prettier --check . && node scripts/format-sql.mjs --check && ruff format --check scripts && find scripts -type f -name '*.sh' -print0 | xargs -0 shfmt -d -i 2 -ci -bn",
    "analyze:unused": "knip --no-progress",
    "test:cpns-resume": "node scripts/test_cpns_resume_flow.mjs",
    "test:db-parity": "node scripts/local-gates/run-gate.mjs parity",
    "cpns:legacy:stage": "node scripts/migrate_cpns_legacy_reviewed_to_schema_v2.mjs",
    "cpns:legacy:repair-inline-assets": "node scripts/repair_cpns_legacy_inline_asset_urls.mjs",
    "cpns:legacy:import:staging": "node scripts/migrate_cpns_legacy_reviewed_to_schema_v2.mjs --import-reviewed && npm run cpns:legacy:repair-inline-assets",
    "db:types:staging": "supabase gen types typescript --project-id lpgrivowdcepcxradavu --schema public > types/database.types.ts",
    "test:question-bank": "node scripts/test-question-bank.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.2",
    "@tiptap/extension-color": "^3.31.0",
    "@tiptap/extension-highlight": "^3.31.0",
    "@tiptap/extension-image": "^3.31.0",
    "@tiptap/extension-link": "^3.31.0",
    "@tiptap/extension-text-align": "^3.31.0",
    "@tiptap/extension-text-style": "^3.31.0",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "@vercel/analytics": "^2.0.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "katex": "^0.18.2",
    "lucide-react": "^0.563.0",
    "midtrans-client": "^1.4.3",
    "next": "~16.4.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-easy-crop": "^5.5.7",
    "react-hook-form": "^7.76.1",
    "react-katex": "^3.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/env": "^16.4.6",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "knip": "^6.41.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.2",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "eslint-plugin-react-hooks": "7.0.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "$sharp",
    "undici": "7.29.0",
    "react-katex": {
      "katex": "$katex"
    }
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ]
}
