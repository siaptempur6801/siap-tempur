# Schema V2 / Vercel Preview only
# Never commit server-side secrets.

APP_ENV=staging
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_SUPABASE_EXPECTED_PROJECT_REF=lpgrivowdcepcxradavu
NEXT_PUBLIC_SUPABASE_URL=https://lpgrivowdcepcxradavu.supabase.co

# Safe public key for browser/server SSR client.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret. Set only in Vercel Preview / server environment.
SUPABASE_SERVICE_ROLE_KEY=

# Keep production Midtrans credentials out of staging.
# Di luar APP_ENV=production, lib/env.ts HANYA membaca varian *_SANDBOX di bawah;
# MIDTRANS_SERVER_KEY / NEXT_PUBLIC_MIDTRANS_CLIENT_KEY diabaikan di staging.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY_SANDBOX=
MIDTRANS_SERVER_KEY_SANDBOX=

NEXT_PUBLIC_SITE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret endpoint cron (mis. /api/cron/reconcile-payments), dikirim sebagai
# header `Authorization: Bearer <CRON_SECRET>`.
# Bila kosong, endpoint cron SELALU membalas 401 (fail-closed) — isi di setiap
# environment yang menjadwalkan cron, jika tidak rekonsiliasi pembayaran akan
# diam-diam berhenti berjalan.
CRON_SECRET=
