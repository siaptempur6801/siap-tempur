# Keep LF in the working tree on every OS. Several unit tests read .sql/.tsv
# fixtures and split on "\n"; CRLF checkouts (core.autocrlf=true on Windows)
# leave a trailing "\r" and break those assertions.
* text=auto eol=lf

# Windows-only scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.xlsx binary
